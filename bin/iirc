#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyyaml>=6"]
# ///
"""The agent's iirc. The only iirc command an agent runs; on PATH as `iirc` while the plugin is enabled.

A thin layer over memoryfield-tool (used as published, at the commit in
iirc.pin). It generates the tool's per-machine config from the
repository location, guards the embedding host, keeps index.md current, and
computes suspicion. It never reimplements storage, search, or indexing.

Usage:
  iirc search QUERY...       ranked pages; several terms are searched separately and merged
  iirc pull QUERY            full text of matching pages
  iirc read PAGE...          print pages
  iirc write PAGE [flags]    body on stdin; see write --help; --store NAME picks the store
  iirc delete PAGE
  iirc verify PAGE           record that the page was re-confirmed
  iirc doubt [--all]         pages with evidence they may be wrong
  iirc approve PAGE          run a page's check once and approve it on this machine
  iirc index                 full reindex and index.md regeneration
  iirc topics                every topic with its page count
  iirc cost                  bytes and tokens of index.md and a search
  iirc doctor [--fix|--brief] check or install prerequisites
  iirc stats [--days N]      how the pages are being used
  iirc knobs [set NAME VALUE] the recall gate's distances; set writes one into .claude/iirc.toml
  iirc tune gather|judge|sweep|done  evidence and judgments for tuning recall, and a sweep of the knobs
  iirc setup                 semantic (default) or string search, and the embedding host; once per machine
  iirc init                  create .iirc/ and the CLAUDE.md paragraph
  iirc sync                  commit, pull, and push every remote store
  iirc stores [add NAME URL] list the stores, or add a remote store (ask the creator first)
"""

from __future__ import annotations

